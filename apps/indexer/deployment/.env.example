# Copy to .env (gitignored) and fill in real values before running deploy-remotely.sh.

# A short, unique name for this stack -- scopes every container, network, and volume name so this
# deployment never collides with another project's on the same Docker host.
PROJECT_PREFIX=aqua-pm-indexer

# A paid, high-throughput Base RPC endpoint. Required: Ponder syncs over plain JSON-RPC
# (eth_getLogs/eth_getBlockByNumber), so a free/public RPC cannot keep up with the Transfer event
# volume of the 4 tokens this indexer watches. Must also be able to serve logs from
# DEPLOYMENT_BLOCK onward (see ponder.config.ts) -- a pruned node that can't will fail with a
# "pruned history unavailable" error.
BASE_RPC_URL=

# Postgres schema Ponder's tables live under. "public" is fine for a dedicated database.
DATABASE_SCHEMA=public

# Postgres (this deployment's own dedicated instance, not shared with any other project's).
POSTGRES_DB=aqua_pm_indexer
POSTGRES_USER=aqua_pm_indexer
POSTGRES_PASSWORD=
# Uppercase IEC suffix required (1G, 512M) -- startdb.sh parses this with `numfmt --from=iec`,
# which is case-sensitive and rejects docker's own more permissive "1g" syntax. Derives Postgres's
# own tuning (shared_buffers, work_mem, etc.) from this value, so it should match the
# deploy.resources limit below it feeds into.
POSTGRES_MEMORY_LIMIT=1G

# Host ports -- pick anything free on the target machine (check `ss -tln` first).
POSTGRES_PORT=
PGBOUNCER_PORT=
POSTGRES_EXPORTER_PORT=
# Ponder's own HTTP server (GraphQL + SQL-over-HTTP + /healthz). Fronted directly by Cloudflare's
# proxy (orange cloud, Flexible SSL) rather than the box's shared Caddy instance -- avoids needing
# write access to Caddy's own config, which is also used by every other project on the host.
# Cloudflare's proxy only forwards to a fixed port allow-list when proxied (80, 8080, 8880, 2052,
# 2082, 2086, 2095 for HTTP) -- this must be one of those.
PONDER_PORT=
