# Copy to .env (gitignored) and fill in real values before running deploy-remotely.sh.

# A short, unique name for this stack -- scopes every container, network, and volume name so this
# deployment never collides with another project's on the same Docker host.
PROJECT_PREFIX=aqua-pm-indexer

# Get a free key at https://envio.dev/app/api-tokens.
ENVIO_API_TOKEN=

# Postgres (this deployment's own dedicated instance, not shared with any other project's).
POSTGRES_DB=aqua_pm_indexer
POSTGRES_USER=aqua_pm_indexer
POSTGRES_PASSWORD=
# Uppercase IEC suffix required (1G, 512M) -- startdb.sh parses this with `numfmt --from=iec`,
# which is case-sensitive and rejects docker's own more permissive "1g" syntax. Derives Postgres's
# own tuning (shared_buffers, work_mem, etc.) from this value, so it should match the
# deploy.resources limit below it feeds into.
POSTGRES_MEMORY_LIMIT=1G

# Host ports -- pick anything free on the target machine (check `ss -tln` first).
POSTGRES_PORT=
PGBOUNCER_PORT=
POSTGRES_EXPORTER_PORT=
# The public GraphQL endpoint (Hasura) the frontend actually queries -- reverse-proxied via Caddy.
HASURA_EXTERNAL_PORT=
ENVIO_INDEXER_PORT=

# A long random secret -- Hasura's own admin API is gated behind this, not behind network
# isolation alone.
HASURA_GRAPHQL_ADMIN_SECRET=

# Optional. Falls back to the public Base RPC (https://mainnet.base.org) when unset -- set a
# dedicated/paid endpoint here if the public one starts rate-limiting the balance-seed reads in
# EventHandlers.ts.
BASE_RPC_URL=
