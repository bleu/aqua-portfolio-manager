# Deployment-level config -- consumed by manage.sh/docker-compose.yml/docker-stack.yml, not by
# the application itself (see ../.env.example for that). Matches apps/indexer/deployment's own
# split between these two env files.

# Unique per deployment on a shared host -- namespaces the Docker Swarm stack, the Compose
# project, the overlay network, and the named volumes so this never collides with another app's.
PROJECT_PREFIX=aqua-pm-arbitrageur

# This deployment's own Postgres (Strategy Catalog, Balance State, Price State, Candidates,
# Execution Attempts -- see ../src/db/schema.ts). Separate from apps/indexer's own database.
POSTGRES_DB=arbitrageur
POSTGRES_USER=arbitrageur
POSTGRES_PASSWORD=
# Host port -- pick one unused on the target machine (check `docker ps` there first).
POSTGRES_PORT=

# This deployment's own Redis, for the six BullMQ queues. Host port -- same caveat as above.
REDIS_PORT=

# The read-only Operations API's host-side port mapping. OPERATIONS_API_PORT below is what the
# process listens on *inside* the container (matches ../.env.example's own default, 3001);
# OPERATIONS_API_HOST_PORT is what's actually exposed on the host -- pick an unused one.
OPERATIONS_API_HOST_PORT=
OPERATIONS_API_PORT=3001

# --- Everything below mirrors ../.env.example (the application's own config) -----------------
# See that file for what each of these means -- not repeated here to avoid the two drifting out
# of sync with contradictory comments. DATABASE_URL and REDIS_URL are NOT set here: docker-stack.yml
# derives them from the Postgres vars above and the internal `postgres`/`redis` service names.

RPC_URL=
PRIVATE_KEY=
ARBITRAGEUR_ADDRESS=
EXECUTOR_VERSION=v1

INDEXER_GRAPHQL_URL=

ALLOWED_TOKENS=
ALLOWED_FEEDS=

FYND_URL=
FYND_CHAIN=base
FYND_SLIPPAGE_BPS=50
FYND_MIN_RESPONSES=1
FYND_TIMEOUT_MS=5000

MIN_PROFIT_USD=5
MIN_TRADE_USD=1
MAX_TRADE_USD=1000

MAX_PRICE_STALENESS_SECONDS=86400
SLIPPAGE_BUFFER_BPS=50
DEADLINE_BUFFER_SECONDS=60

CONFIRMATION_DEPTH=5
MAX_RETRIES=3
SYNC_INTERVAL_MS=5000
RECOVERY_INTERVAL_MS=60000

SLACK_WEBHOOK_URL=

OPERATIONS_API_TOKEN=

# Starts in dry-run mode on purpose -- see docker-stack.yml's own comment on this default.
DRY_RUN=true
