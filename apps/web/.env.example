# Optional. Registers the WalletConnect connector on the connect-wallet page -- get a real project
# ID at https://cloud.reown.com. Without it, wallet connection still works via an injected wallet
# (MetaMask, a Safe{Wallet} in-app browser, etc.), just not WalletConnect's QR-code flow.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Required. Portfolio Manager contracts on Base mainnet (packages/contracts/script/Deploy.s.sol).
# Redeploying the protocol pieces means updating all four here -- never hardcode these in src/.
NEXT_PUBLIC_PM_ROUTER_ADDRESS=
NEXT_PUBLIC_PM_TOKEN_REGISTRY_ADDRESS=
NEXT_PUBLIC_PM_FEED_REGISTRY_ADDRESS=
NEXT_PUBLIC_PM_STRATEGY_VALIDATOR_ADDRESS=

# Required. The external Aqua registry this deployment's contracts were built against
# (packages/addresses/base-mainnet.json's "aqua" field) -- shared 1inch infrastructure, not ours.
NEXT_PUBLIC_AQUA_ADDRESS=

# Required for the basket-scope-guard check (docs/adr/0011). The apps/indexer GraphQL endpoint --
# without it, the Review page skips the prior-strategy conflict check entirely.
NEXT_PUBLIC_INDEXER_GRAPHQL_URL=
