# RPC endpoint the E2E test suite (packages/contracts/test/e2e/) forks directly via
# vm.createSelectFork(vm.envOr("BASE_RPC_URL", ...)) -- see test/e2e/base/AquaE2EBase.t.sol.
#
# Defaults to Base's public RPC if unset, which works but is rate-limited and can be flaky for
# repeated forking — get a real key from Alchemy, dRPC, or Infura for anything beyond a quick
# smoke test.
BASE_RPC_URL=https://mainnet.base.org
