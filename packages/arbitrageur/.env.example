# RPC endpoint -- a local Base-mainnet fork (anvil) for testing, or a real mainnet RPC once the
# strategy is actually deployed.
RPC_URL=http://127.0.0.1:8545

# EOA that owns the Arbitrageur contract and holds the tokens it trades. Never commit a real key.
PRIVATE_KEY=0x

# The deployed Arbitrageur contract (see README for how to deploy one).
ARBITRAGEUR_ADDRESS=0x

# The PM strategy's order, as shipped -- opaque, immutable calldata (see docs/ARCHITECTURE.md /
# docs/guides/). Get these three values from whatever shipped the strategy (a script's logs, an
# indexer entry, or the E2E fixtures' own _buildOrder for local testing).
PM_ORDER_MAKER=0x
PM_ORDER_TRAITS=0
PM_ORDER_DATA=0x

# The two-token pair to watch. Must both be members of the shipped strategy's declared universe.
TOKEN_IN=0x4200000000000000000000000000000000000006
TOKEN_OUT=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb

# The SAME Chainlink feeds the strategy itself declared for these two tokens -- arbitrage here
# means "does the curve's own price match what its own oracle says it should be."
FEED_IN=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
FEED_OUT=0x591e79239a7d679378eC8c847e5038150364C78F

# How often to check for an opportunity.
POLL_INTERVAL_MS=15000

# Minimum profit (standard bps, 1/10_000) required before executing a trade.
MIN_PROFIT_BPS=20

# Search bounds for candidate trade sizes, in tokenIn's own smallest unit.
MIN_TRADE_AMOUNT=1000000000000000
MAX_TRADE_AMOUNT=10000000000000000000

# How many geometrically-spaced sizes to probe within the bounds above.
SEARCH_STEPS=12

# On-chain tx deadline, seconds from submission.
DEADLINE_BUFFER_SECONDS=60

# Safety margin subtracted from the search-time quote before submitting the real trade, since the
# price can move between quoting and execution.
SLIPPAGE_BUFFER_BPS=50

# Set to "true" to log opportunities without ever submitting a transaction.
DRY_RUN=true
