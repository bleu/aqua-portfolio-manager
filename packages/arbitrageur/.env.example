# RPC endpoint -- a local Base-mainnet fork (anvil) for testing, or a real mainnet RPC once the
# strategy is actually deployed.
RPC_URL=http://127.0.0.1:8545

# EOA that owns the Arbitrageur contract. Only pays gas now -- the flash-loan path means it never
# needs to hold or approve any of the traded tokens (see README's "Flash-loan execution" section).
# Never commit a real key.
PRIVATE_KEY=0x

# The deployed Arbitrageur contract (see README for how to deploy one, including the Uniswap V4
# PoolManager address its constructor now needs), and a label for this deployment -- recorded on
# every Execution Attempt (ADR-0014).
ARBITRAGEUR_ADDRESS=0x
EXECUTOR_VERSION=v1

# This service's own Postgres (Strategy Catalog, Balance State, Price State, Candidates, Execution
# Attempts) -- separate from packages/indexer's own Envio-managed database. See db/schema.ts.
DATABASE_URL=postgres://localhost:5432/arbitrageur

# Redis, for the six BullMQ queues (sync-indexer, evaluate-strategy, simulate-candidate,
# execute-candidate, track-transaction, retry-evaluation -- see ADR-0014's Queue rules).
REDIS_URL=redis://localhost:6379

# The running packages/indexer instance's GraphQL endpoint. Local default when running `envio dev`
# is http://localhost:8080/v1/graphql with admin secret "testing"; a hosted Envio deployment needs
# no admin secret at all.
INDEXER_GRAPHQL_URL=http://localhost:8080/v1/graphql
INDEXER_ADMIN_SECRET=testing

# Strategies declaring a token outside this list are recorded but never traded (ADR-0014's
# Decision section). Comma-separated. Must match packages/indexer/config.yaml's ChainlinkProxy
# token order for USDC, USDT, WETH, WBTC on Base.
ALLOWED_TOKENS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2,0x4200000000000000000000000000000000000006,0x1ceA84203673764244E05693e42E6Ace62bE9BA5

# A locally-running Fynd server (propeller-heads/fynd) -- see README's "Running a local Fynd
# server" section. Finds the best real-market route for the return leg of each flash arbitrage.
# Uniswap V4 is excluded from every quote (src/fynd.ts) since the executor's own flash loan
# already holds the PoolManager's only unlock session.
FYND_URL=http://127.0.0.1:3000
FYND_CHAIN=base
FYND_SLIPPAGE_BPS=50
FYND_MIN_RESPONSES=1
FYND_TIMEOUT_MS=5000

# Minimum profit in USD (plain decimal, e.g. "5" or "5.50") required before a Candidate is
# created -- a dollar floor covers gas more reliably than a relative bps threshold.
MIN_PROFIT_USD=5

# Search bounds for candidate trade sizes, in tokenIn's own smallest unit, and how many
# geometrically-spaced sizes to probe within them.
MIN_TRADE_AMOUNT=1000000000000000
MAX_TRADE_AMOUNT=10000000000000000000
SEARCH_STEPS=12

# A Price Snapshot older than this (seconds, measured against its own reported block time) is
# treated as unusable -- that leg is skipped for this evaluation, not the whole tick.
MAX_PRICE_STALENESS_SECONDS=3600

# Safety margin subtracted from the search-time curve quote before submitting the real trade, and
# the on-chain tx deadline (seconds from submission).
SLIPPAGE_BUFFER_BPS=50
DEADLINE_BUFFER_SECONDS=60

# How many block confirmations (checked against live chain depth -- see src/domains/tracking.ts's
# own doc comment on this simplification) before an Execution Attempt is marked final.
CONFIRMATION_DEPTH=5

# ADR-0014: "The service allows three retries for one Strategy State."
MAX_RETRIES=3

# How often (ms) sync-indexer pulls new data from the indexer and re-evaluates every eligible
# Strategy -- also doubles as the ADR's own "low-rate recovery job".
SYNC_INTERVAL_MS=5000
RECOVERY_INTERVAL_MS=60000

# Slack incoming webhook for transaction and critical-fault messages (ADR-0014's Notification
# domain). Leave unset to disable Slack notifications entirely.
SLACK_WEBHOOK_URL=

# The read-only Operations API's own port and bearer token -- never commit a real token. Default
# 3001, not 3000: Fynd's own local server defaults to 3000 (see FYND_URL above), so this avoids
# colliding with it out of the box.
OPERATIONS_API_PORT=3001
OPERATIONS_API_TOKEN=

# Set to "true" to evaluate and simulate candidates without ever submitting a transaction --
# ADR-0014: "starts in dry-run mode. A configuration change enables transaction submission."
DRY_RUN=true
