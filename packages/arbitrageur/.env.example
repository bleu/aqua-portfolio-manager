# RPC endpoint -- a local Base-mainnet fork (anvil) for testing, or a real mainnet RPC once the
# strategy is actually deployed.
RPC_URL=http://127.0.0.1:8545

# EOA that owns the Arbitrageur contract. Only pays gas now -- the flash-loan path means it never
# needs to hold or approve any of the traded tokens (see README's "Flash-loan execution" section).
# Never commit a real key.
PRIVATE_KEY=0x

# The deployed Arbitrageur contract (see README for how to deploy one, including the Uniswap V4
# PoolManager address its constructor now needs).
ARBITRAGEUR_ADDRESS=0x

# The PM strategy's order, as shipped -- opaque, immutable calldata (see docs/ARCHITECTURE.md /
# docs/guides/). Get these three values from whatever shipped the strategy (a script's logs, an
# indexer entry, or the E2E fixtures' own _buildOrder for local testing).
PM_ORDER_MAKER=0x
PM_ORDER_TRAITS=0
PM_ORDER_DATA=0x

# The strategy's two-group basket: group A = {USDT, USDC}, group B = {WBTC, WETH}. Comma-separated,
# positionally matched to the feeds below. Every group-A token is watched against every group-B
# token, both directions -- the PM curve only ever prices a trade across two different groups.
GROUP_A_TOKENS=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2,0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
GROUP_A_FEEDS=0xf19d560eB8d2ADf07BD6D13ed03e1D11215721F9,0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
GROUP_B_TOKENS=0x1ceA84203673764244E05693e42E6Ace62bE9BA5,0x4200000000000000000000000000000000000006
GROUP_B_FEEDS=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F,0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70

# A locally-running Fynd server (propeller-heads/fynd) -- see README's "Running a local Fynd
# server" section. This server finds the best real-market route for the return leg of each flash
# arbitrage (converting the curve's payout back into the borrowed token to repay the loan).
FYND_URL=http://127.0.0.1:4000
FYND_CHAIN=base

# Extra slippage tolerance requested on Fynd's own route, standard bps (1/10_000) -- on top of
# whatever buffer SLIPPAGE_BUFFER_BPS already applies to the curve leg's own minimum.
FYND_SLIPPAGE_BPS=50

# How often (ms) the bot polls the RPC for a new block. A tick runs once per new block seen, not
# on a fixed timer -- this only controls how quickly a new block is noticed, not the bot's actual
# cadence. Set close to the chain's real block time (Base is ~2s).
BLOCK_POLLING_INTERVAL_MS=2000

# Minimum profit (standard bps, 1/10_000) required before executing a trade.
MIN_PROFIT_BPS=20

# Search bounds for candidate trade sizes, in tokenIn's own smallest unit.
MIN_TRADE_AMOUNT=1000000000000000
MAX_TRADE_AMOUNT=10000000000000000000

# How many geometrically-spaced sizes to probe within the bounds above.
SEARCH_STEPS=12

# On-chain tx deadline, seconds from submission.
DEADLINE_BUFFER_SECONDS=60

# Safety margin subtracted from the search-time curve quote before submitting the real trade,
# since the price can move between quoting and execution.
SLIPPAGE_BUFFER_BPS=50

# Set to "true" to log opportunities without ever submitting a transaction.
DRY_RUN=true
